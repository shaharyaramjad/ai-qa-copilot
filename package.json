{
  "name": "ai-qa-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted QA workflow: acceptance criteria -> test cases -> Playwright tests",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "check:llm": "bash scripts/check-llm.sh",
    "ai:review": "node scripts/ai.mjs review",
    "ai:cases": "node scripts/ai.mjs cases",
    "ai:automate": "node scripts/ai.mjs automate",
    "break-check": "bash scripts/break-check.sh",
    "agent": "bash scripts/agent.sh",
    "gate": "bash scripts/gate.sh",
    "review": "bash scripts/review.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
