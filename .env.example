# Copy this file to .env and fill in the key. .env is git-ignored. Never commit real keys.
# These values point any OpenAI-compatible agent tool at the local FreeLLMAPI router.

# Desktop app: copy the Base URL from the app's Agents page (it was http://127.0.0.1:31415/v1).
# Docker / source installs use http://localhost:3001/v1
LLM_BASE_URL=http://127.0.0.1:31415/v1
# Unified key shown in the FreeLLMAPI tray popover / Keys page (starts with freellmapi-)
LLM_API_KEY=
# "auto" lets the router pick the best available free model and fail over on errors
LLM_MODEL=auto
